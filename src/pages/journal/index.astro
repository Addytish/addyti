---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<Base title="Journal — Addyti">
  <div class="page">
    <h1>Journal</h1>
    {posts.length === 0 ? (
      <p class="empty">First post coming soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <h2><a href={`${base}/journal/${post.id}/`}>{post.data.title}</a></h2>
            <div class="post-date">{fmt.format(post.data.date)}</div>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
